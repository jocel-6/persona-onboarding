# Copy to .env and fill in. Never commit .env.

# --- The brain (Phase 1) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5          # fallback if voice latency is too high: claude-haiku-4-5
LLM_THINKING=adaptive              # adaptive | disabled
LLM_EFFORT=low                     # low keeps turns fast

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
GMAIL_STUB=1                       # Phase 1 stand-in for Google sign-in; set 0 once real OAuth lands

