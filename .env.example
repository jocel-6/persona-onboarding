# Copy to .env and fill in. Never commit .env.

# --- The brain (Phase 1) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5          # fallback if voice latency is too high: claude-haiku-4-5
LLM_THINKING=disabled              # disabled is ~30% faster to first word; adaptive | disabled
LLM_EFFORT=low                     # low keeps turns fast

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
GMAIL_STUB=1                       # Phase 1 stand-in for Google sign-in; set 0 once real OAuth lands

# --- Voice (Phase 2) ---
# Without these, calls still work: you type on the call screen instead of talking.
DEEPGRAM_API_KEY=                  # speech-to-text (required for voice)
TTS_PROVIDER=cartesia              # cartesia | elevenlabs | openai
TTS_VOICE_ID=                      # pick with: cd backend && .venv/bin/python scripts/voices.py list
TTS_MODEL=                         # optional; provider default otherwise
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=                    # optional: OpenAI voices as a bake-off baseline
SILENCE_CHECKIN_SECS=5             # gentle check-in after this much silence
SILENCE_OFFER_TEXT_SECS=10         # then offer to switch to text after this much more

# --- Google (Phase 3) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
