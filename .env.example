# Copy to .env and fill in. Never commit .env.

# --- The brain (Phase 1) ---
ANTHROPIC_API_KEY=
# fallback if voice latency is too high: claude-haiku-4-5
LLM_MODEL=claude-sonnet-5
# disabled is ~30% faster to first word; adaptive | disabled
LLM_THINKING=disabled
# low keeps turns fast
LLM_EFFORT=low

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Voice (Phase 2) ---
# Without these, calls still work: you type on the call screen instead of talking.
# speech-to-text (required for voice)
DEEPGRAM_API_KEY=
# cartesia | elevenlabs | openai
TTS_PROVIDER=cartesia
# pick with: cd backend && .venv/bin/python scripts/voices.py list
TTS_VOICE_ID=
# optional; provider default otherwise
TTS_MODEL=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
# optional: OpenAI voices as a bake-off baseline
OPENAI_API_KEY=
# gentle check-in after this much silence
SILENCE_CHECKIN_SECS=5
# then offer to switch to text after this much more
SILENCE_OFFER_TEXT_SECS=10

# --- Gmail (Phase 3) ---
# Without these, a clearly labeled stand-in replaces Google sign-in. Setup guide: docs/google-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
# Offer "Can't sign in? Use demo data" (clearly labeled, never on by default)
ALLOW_DEMO_DATA=1

# --- Beyond the spec (docs/ROADMAP.md) ---
# Speech-to-text engine: nova (default, proven) | flux (conversational + speculative replies, #1)
STT_ENGINE=nova
# #2 instant "mm-hm" if the reply hasn't started this soon (ms); 1 = on
VOICE_ACKS=1
ACK_DELAY_MS=450
# #3 voice speed/emotion follow the user's mood (Cartesia); 1 = on
VOICE_TONE=1
# #6 deeper background insights after Gmail connects (~$0.01-0.02 per connection); 1 = on
DEEP_INSIGHTS=1
DEEP_INSIGHTS_MODEL=claude-sonnet-5
# #5 tone of voice (Hume); leave empty to keep it off
HUME_API_KEY=
# #13 real phone calls + SMS recap (Twilio); PUBLIC_BASE_URL must be https and reach this server
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
# #16 protect /api/metrics with ?token=
METRICS_TOKEN=
